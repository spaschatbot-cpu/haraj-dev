<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة البدء التي يرسمها **النظام** قبل أوّل إطارٍ من Flutter.

  والشعارُ فيها لا لونٌ وحدَه: بدونه يرى المستخدم مستطيلاً كحليّاً فارغاً ثمّ
  يقفز الشعارُ إلى الوجود حين يُقلع المحرّك — وهو ما يُقرأ ومضةً. ومعه تصير
  الشاشتان صورةً واحدةً تستمرّ، ولا يُعرف أين انتهت واحدةٌ وبدأت الأخرى.

  و`launch_logo.png` نسخةٌ من `assets/images/logo.png`: النظامُ لا يقرأ أصول
  Flutter، فالملفّ مكتوبٌ مرّتين بالضرورة. من بدّل الشعارَ يبدّل الاثنين.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>

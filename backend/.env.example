# Copy to .env and fill in. .env is never committed.
#
# Pick the settings module with DJANGO_SETTINGS_MODULE:
#   config.settings.dev   local development (the default)
#   config.settings.test  test runs — inherits prod
#   config.settings.prod  production
DJANGO_SETTINGS_MODULE=config.settings.dev

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Shown on /health and in every message leaving a non-production environment.
ENVIRONMENT_NAME=dev
# Set by the build; leave empty locally and /health reads the git ref instead.
GIT_COMMIT=

DATABASE_URL=postgres://haraj:haraj@127.0.0.1:5432/haraj2
TEST_DATABASE_URL=postgres://haraj:haraj@127.0.0.1:5432/haraj2_test

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

INSURANCE_DEPOSIT_AMOUNT=10000

# نسبة ضريبة القيمة المضافة. الفاتورة المحلية مبالغها قبلها، والواردة من
# أودو شاملةٌ لها — و`money.services.tax_of` وحدها تعرف الفرق (HR-05).
VAT_RATE=0.15

# قاعدة v1 — للقراءة فقط، وفارغة افتراضياً (الفيز 004).
# الفارغ يعني «لا اتصال»، لا «اتصالٌ لم يجد شيئاً»: ترحيلٌ يتصل بلا شيء
# ويُبلّغ عن صفر صفوفٍ كأنها نجاح هو العطل الوحيد الذي لا يجوز للترحيل.
# والحساب هنا **مقيَّد بالقراءة عند المنحة نفسها** لا بامتناع الكود (D6).
# V1_DSN=mysql://readonly_user:PASSWORD@127.0.0.1:3306/hara_clone_v1

# Signing in. The console backend logs the one-time code instead of sending it,
# which is right locally and refused by `check --deploy` anywhere else.
SMS_BACKEND=apps.accounts.sms.console_backend
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# The smallest bid the platform accepts. Not a price a car stands on — that is
# `Vehicle.reserve_price` — and never derived from one.
MINIMUM_BID=1000

# ---------------------------------------------------------------------------
# الحافة — من ينادي، وكم مرة. T914.
#
# CACHE_URL هو ما يجعل الحدود حدوداً: كل عامل gunicorn يملك ذاكرته الخاصة،
# فذاكرة محلية تحوّل «خمسة في الساعة» إلى «خمسة × عدد العمّال» بلا أي سطر
# يقول ذلك. `manage.py check --deploy` يرفض بيئة منشورة على ذاكرة محلية.
# Redis مطفأ على أجهزة التطوير هنا — والحل ليس تعطيل الحدود بل قاعدة 2:
# قواعد 0 و1 لـCelery، وFLUSHDB على طابور لا يجوز أن يصفّر عدّادات الحدود.
# ---------------------------------------------------------------------------
CACHE_URL=redis://127.0.0.1:6379/2

# عدد الوسطاء (proxies) أمام هذه العملية.
#
# 0 = التطبيق يُنادى مباشرةً، فـREMOTE_ADDR هو الحقيقة و X-Forwarded-For مجرّد
# ترويسة يكتبها المنادي وتُهمَل. خلف nginx واحد: 1، فتُقرأ آخر مدخلة وحدها.
# الرقم واحد لـ`apps.core.net` ولـDRF معاً — وجوابان لسؤال «من ينادي» يعنيان
# حدّين مختلفين، ولهذا يفشل check --deploy لو اختلفا.
TRUSTED_PROXY_HOPS=0

# حدود المسارات التي لا تصلها throttles الخاصة بـDRF.
ODOO_WEBHOOK_RATE=600/minute
PAYMENT_CALLBACK_RATE=600/minute
# دخول الموظفين بكلمة مرور — الطريق إلى money.act وmoney.exception.
STAFF_LOGIN_RATE_PER_IP=10/hour
STAFF_LOGIN_RATE_PER_ACCOUNT=5/hour

# حدود العملاء (T602 وT611). موجودة هنا لتُقرأ مع أخواتها.
OTP_SEND_RATE_PER_PHONE=5/hour
OTP_SEND_RATE_PER_CALLER=20/hour
OTP_VERIFY_RATE_PER_CALLER=30/hour
BID_RATE_PER_CALLER=60/hour

# ---------------------------------------------------------------------------
# الرفع — T912. المكان الذي عاشت فيه webshell أشهراً في v1.
#
# MEDIA_ROOT مجلد مستقل خارج جذر الويب وخارج STATIC_ROOT. الخادم يقدّمه
# كبايتات جامدة ولا يفسّر شيئاً منه — المقطع الكامل في docs/runbooks/uploads.md،
# و`manage.py check --deploy` يفشل لو صار Django هو من يقدّمه.
# ---------------------------------------------------------------------------
# MEDIA_ROOT=/srv/haraj/media

# عشرة ميجابايت. صورة سيارة من جوال بين واحد وأربعة.
UPLOAD_MAX_BYTES=10485760
# تُقرأ من ترويسة الصورة قبل أي فكّ ضغط: ملف بحجم 6 كيلوبايت يمكن أن يعلن
# 40000×40000 ويطلب جيجابايتات لحظة فتحه، وحدّ البايتات لا يرى ذلك.
UPLOAD_MAX_IMAGE_PIXELS=50000000
UPLOAD_MAX_IMAGE_EDGE=12000
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152

# Odoo stays off until someone turns it on deliberately.
ODOO_ENABLED=False
ODOO_BASE_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_WEBHOOK_SECRET=

# Production only — the settings module refuses to boot without these.
# ENVIRONMENT_NAME=production
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# CONN_MAX_AGE=60
# LOG_LEVEL=INFO
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

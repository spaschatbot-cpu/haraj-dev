# Copy to .env and fill in. .env is never committed.
#
# **٦٨ اسماً** يقرؤها الكودُ من البيئة في الخلفيّة، وهي كلُّها هنا — الجردُ
# المقيس في `docs/environment-contract.md`. وكان هذا الملفُّ يذكر ٣٥ منها
# فقط، فمن نسخه وملأه **ظنَّ أنه أتمّ الإعداد** وهو لم يكتب مفتاحَ دفعٍ ولا
# توكنَ رسائلَ ولا أصلَ وسائط.
#
# ولكلِّ سطرٍ تعليقٌ يقول **ماذا يحدث إن غاب**، لأن الغياب ثلاثُ درجات:
#   ❌ الإقلاعُ يسقط في الثانية الأولى، بأثرٍ كامل.
#   🛑 `manage.py check --deploy` يرفض — إن شُغِّل، وهو آخرُ خطوةٍ قبل المرور.
#   🔇 **تكاملٌ يُعطَّل بصمت**: كلُّ شيءٍ أخضر، ولا رسالةَ تصل ولا فاتورةَ تُرحَّل.
# والثالثةُ هي الخطيرة، ولذلك صارت الآن مسموعةً في `apps/*/checks.py`.
#
# **ولا قيمةَ حقيقيّةً واحدةً في هذا الملفّ.** كلُّ مثالٍ ظاهرُ الزيف
# (`REPLACE_ME`، `example.invalid`) — ومفتاحٌ وصل المستودعَ محروقٌ ولو حُذف.
#
# Pick the settings module with DJANGO_SETTINGS_MODULE:
#   config.settings.dev   local development (the default)
#   config.settings.test  test runs — inherits prod
#   config.settings.prod  production
DJANGO_SETTINGS_MODULE=config.settings.dev

# ⚠️ غائباً: كلُّ أمرٍ يعمل بإعدادات التطوير — DEBUG=True في الإنتاج.
DEBUG=True
# ❌ في الإنتاج: `RuntimeError` قبل أن يُحمَّل تطبيقٌ واحد. ٥٠ محرفاً عشوائياً.
SECRET_KEY=change-me
# ❌ في الإنتاج: `RuntimeError`. وقائمةٌ فارغة تعني قبولَ أيّ ترويسة Host.
ALLOWED_HOSTS=localhost,127.0.0.1

# Shown on /health and in every message leaving a non-production environment.
# ⚠️ قيمةٌ خاطئة تختم كلَّ رسالةٍ صادرةٍ بلافتة بيئة (المادة ٥-٦).
ENVIRONMENT_NAME=dev
# Set by the build; leave empty locally and /health reads the git ref instead.
GIT_COMMIT=
# مسارُ لوحة الموظّفين. غائباً: `console` — افتراضٌ يعمل.
APP_BASE=console
# مستوى السجلّ في الإنتاج وحده. غائباً: `INFO`.
# LOG_LEVEL=INFO
# 🔇 الإنتاج: كلُّ `POST` من أصلٍ آخر (الويب على Vercel) يُرفض 403 بلا سببٍ ظاهر.
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# القاعدة
#
# 🔇 `DATABASE_URL` غائباً **كان** يُقلع صامتاً على قاعدة التطوير — وعلى آلةٍ
# فيها PostgreSQL محلّيّ قد يتّصل فعلاً، فيكتب إنتاجٌ كاملٌ في دفترٍ ليس دفتره.
# صار `config/settings/prod.py` يرفض الغيابَ **ويرفض قيمةَ التطوير نفسَها**.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://haraj:haraj@127.0.0.1:5432/haraj2
TEST_DATABASE_URL=postgres://haraj:haraj@127.0.0.1:5432/haraj2_test
# عمرُ الاتّصال المُعاد استعمالُه في الإنتاج وحده. غائباً: ٦٠ ثانية.
# CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# الطوابير — ولا جدولةَ دوريّة في هذا المشروع.
#
# 🔇 حاملٌ غيرُ مضبوط = **لا تحريكَ مالٍ عند نهاية المزاد**: فكُّ تأمين الخاسر
# وفوترةُ الفائز محجوزان بـ`apply_async(eta=ends_at)`. لا استثناءَ يُرفع، ولا
# سطرَ في سجلّ. و`core.E012` يمسك الفارغ، و`core.W011` يمسك «هذه الآلة».
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

INSURANCE_DEPOSIT_AMOUNT=10000

# نسبة ضريبة القيمة المضافة. الفاتورة المحلية مبالغها قبلها، والواردة من
# أودو شاملةٌ لها — و`money.services.tax_of` وحدها تعرف الفرق (HR-05).
VAT_RATE=0.15

# قاعدة v1 — للقراءة فقط، وفارغة افتراضياً (الفيز 004).
# الفارغ يعني «لا اتصال»، لا «اتصالٌ لم يجد شيئاً»: ترحيلٌ يتصل بلا شيء
# ويُبلّغ عن صفر صفوفٍ كأنها نجاح هو العطل الوحيد الذي لا يجوز للترحيل.
# والحساب هنا **مقيَّد بالقراءة عند المنحة نفسها** لا بامتناع الكود (D6).
# V1_DSN=mysql://readonly_user:PASSWORD@127.0.0.1:3306/hara_clone_v1
# مسارُ نسخة mysqldump حين يُرحَّل من ملفٍّ لا من خادم. غائباً: تطلبه أوامرُ
# الترحيل بـ`--dump` صراحةً وإلا فشلت — وهو فشلٌ مسموع.
# V1_DUMP_PATH=D:/tmp/haraj_db_dump/dump.sql

# Signing in. The console backend logs the one-time code instead of sending it,
# which is right locally and refused by `check --deploy` anywhere else.
SMS_BACKEND=apps.accounts.sms.console_backend
OTP_CODE_DIGITS=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# بوّابةُ الرسائل — OURSMS، وهي نفسُها التي يرسل منها v1.
#
# 🔇 توجيهُ `SMS_BACKEND` إلى المزوّد الحقيقيّ بلا هذين **كان يمرّ بـ`rc=0`**:
# كلُّ محاولةِ دخولٍ ترفع `SmsSendFailed` ويُكتب السطرُ في `SmsFailure`، ولا
# أحدَ ينظر في جدولٍ لا يعرف أنه امتلأ. صار `accounts.E004` يرفض.
# وهو عطلُ v1 بوجهٍ آخر: `sendSmsSafely` تبتلع ردَّ المزوّد فلا يعرف أحدٌ أن
# الرصيد نفد.
# ---------------------------------------------------------------------------
# OURSMS_API_URL=https://api.oursms.example.invalid/msgs/sms
# OURSMS_TOKEN=REPLACE_ME
# اسمُ المُرسِل. غائباً: `HirajOne`. واسمٌ غيرُ مسجَّلٍ عند المزوّد يرفضه هو.
# OURSMS_SENDER=HirajOne

# The smallest bid the platform accepts. Not a price a car stands on — that is
# `Vehicle.reserve_price` — and never derived from one.
MINIMUM_BID=1000

# ---------------------------------------------------------------------------
# الدفع بالبطاقة — Moyasar. **ثلاثةُ مفاتيحَ لطريقٍ واحد**، وكلُّ واحدٍ منها
# مستقلٌّ وفارغٌ افتراضاً، فبيئةٌ فيها اثنان من ثلاثة تبدو سليمةً تماماً.
#
# 🔇 زرٌّ يعمل بلا `PAYMENT_WEBHOOK_SECRET` = العميلُ يدفع وتردّ نقطةُ الاستقبال
#    503 ولا تُشحن محفظته (`money.E001`).
# 🔇 سرٌّ بلا بوّابة = ردٌّ نقبله عن دفعةٍ لا نستطيع إرسالَ أحدٍ ليدفعها
#    (`money.E002`).
# 🔇 بلا `MOYASAR_SECRET_KEY` مع الاستعلام التأكيديّ = كلُّ دفعةٍ `Unconfirmed`
#    فلا تُقيَّد ولا تُرفض (`money.E004`).
# ---------------------------------------------------------------------------
# PAYMENT_GATEWAY=moyasar
# PAYMENT_WEBHOOK_SECRET=whsec_REPLACE_ME
# MOYASAR_SECRET_KEY=sk_test_REPLACE_ME
# MOYASAR_API_BASE=https://api.moyasar.com/v1
# ⚠️ وحدةُ المبلغ عند البوّابة: `minor` (هللة — افتراضُ Moyasar) أو `major`
# (ريال). قيمةٌ خاطئةٌ تقرأ كلَّ دفعةٍ مئةَ ضعفها أو جزءاً من مئة، والمجهولةُ
# تُرفض ولا تُخمَّن (`money.E006`).
# PAYMENT_AMOUNT_UNIT=minor
# الاستعلامُ من البوّابة قبل التقييد — مصدرُ الحقيقة، كـ v1 في كل مسار.
# `False` إعلانُ مشغّلٍ صريحٌ ببوّابةٍ بلا واجهةِ استعلام، ويُنبَّه عليه.
# PAYMENT_CONFIRM_WITH_GATEWAY=True
# كلماتُ البوّابة التي تعني «وصل المال». غائباً: `paid`.
# PAYMENT_SUCCESS_STATUSES=paid
# كم دقيقةً تبقى نيّةُ الدفع قابلةً للدفع. غائباً: ١٢٠ (ساعتان كـ v1).
# PAYMENT_INTENT_TTL_MINUTES=120
# قالبُ صفحة الدفع — احتياطٌ لبوّابةٍ غير Moyasar. **لا بدّ أن يذكر
# `{reference}`**، وإلا وصلت الدفعةُ بلا صاحب (`money.E005`).
# PAYMENT_CHECKOUT_TEMPLATE=https://pay.example.invalid/{reference}
# أين يعود العميلُ بعد الدفع. فارغاً: لا `callback_url`، فيبقى عند البوّابة.
# PAYMENT_RETURN_URL_TEMPLATE=https://app.example.invalid/wallet/{reference}

# ---------------------------------------------------------------------------
# الحافة — من ينادي، وكم مرة. T914.
#
# CACHE_URL هو ما يجعل الحدود حدوداً: كل عامل gunicorn يملك ذاكرته الخاصة،
# فذاكرة محلية تحوّل «خمسة في الساعة» إلى «خمسة × عدد العمّال» بلا أي سطر
# يقول ذلك. `manage.py check --deploy` يرفض بيئة منشورة على ذاكرة محلية.
# Redis مطفأ على أجهزة التطوير هنا — والحل ليس تعطيل الحدود بل قاعدة 2:
# قواعد 0 و1 لـCelery، وFLUSHDB على طابور لا يجوز أن يصفّر عدّادات الحدود.
# 🔇 وRedis غيرُ الموجود على هذا العنوان **يُسقط كلَّ مسارٍ فيه حدٌّ بـ500**،
# ابتداءً من صفحة الدخول (`core.W012` يقول «هذه الآلة» ولا يعرف أهي حيّة).
# ---------------------------------------------------------------------------
CACHE_URL=redis://127.0.0.1:6379/2

# عدد الوسطاء (proxies) أمام هذه العملية.
#
# 0 = التطبيق يُنادى مباشرةً، فـREMOTE_ADDR هو الحقيقة و X-Forwarded-For مجرّد
# ترويسة يكتبها المنادي وتُهمَل. خلف nginx واحد: 1، فتُقرأ آخر مدخلة وحدها.
# الرقم واحد لـ`apps.core.net` ولـDRF معاً — وجوابان لسؤال «من ينادي» يعنيان
# حدّين مختلفين، ولهذا يفشل check --deploy لو اختلفا.
# ❌ وقيمةٌ غيرُ رقميّةٍ تُسقط الإقلاع (`ValueError`).
TRUSTED_PROXY_HOPS=0

# حدود المسارات التي لا تصلها throttles الخاصة بـDRF.
ODOO_WEBHOOK_RATE=600/minute
PAYMENT_CALLBACK_RATE=600/minute
# دخول الموظفين بكلمة مرور — الطريق إلى money.act وmoney.exception.
STAFF_LOGIN_RATE_PER_IP=10/hour
STAFF_LOGIN_RATE_PER_ACCOUNT=5/hour

# حدود العملاء (T602 وT611). موجودة هنا لتُقرأ مع أخواتها.
OTP_SEND_RATE_PER_PHONE=5/hour
OTP_SEND_RATE_PER_CALLER=20/hour
OTP_VERIFY_RATE_PER_CALLER=30/hour
BID_RATE_PER_CALLER=60/hour

# ---------------------------------------------------------------------------
# الرفع — T912. المكان الذي عاشت فيه webshell أشهراً في v1.
#
# MEDIA_ROOT مجلد مستقل خارج جذر الويب وخارج STATIC_ROOT. الخادم يقدّمه
# كبايتات جامدة ولا يفسّر شيئاً منه — المقطع الكامل في docs/runbooks/uploads.md،
# و`manage.py check --deploy` يفشل لو صار Django هو من يقدّمه.
# ---------------------------------------------------------------------------
# MEDIA_ROOT=/srv/haraj/media

# 🛑 أصلُ الصور. `check --deploy` يرفض الفارغَ بـ`core.E010`؛ ولو لم يُشغَّل
# الفحص فكلُّ صورةٍ تُطلب من أصل العميل فترجع 404 بلا سطرٍ في أيّ سجلّ —
# والبطاقةُ تظهر كأن لا صورة لها. في التطوير: منفذُ الخادم الذي يعمل فعلاً.
# MEDIA_BASE_URL=http://127.0.0.1:8001

# عشرة ميجابايت. صورة سيارة من جوال بين واحد وأربعة.
UPLOAD_MAX_BYTES=10485760
# تُقرأ من ترويسة الصورة قبل أي فكّ ضغط: ملف بحجم 6 كيلوبايت يمكن أن يعلن
# 40000×40000 ويطلب جيجابايتات لحظة فتحه، وحدّ البايتات لا يرى ذلك.
UPLOAD_MAX_IMAGE_PIXELS=50000000
UPLOAD_MAX_IMAGE_EDGE=12000
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152

# ---------------------------------------------------------------------------
# أودو — مطفأٌ حتى يُشغّله مشغّلٌ عمداً، وذلك ليس عطلاً ولا يُنبَّه عليه.
#
# 🔇 العطلُ هو **المُفعَّلُ الأعمى**: `ODOO_ENABLED=True` وينقصه ما يجعله شغّالاً.
# كان يمرّ بـ`rc=0`، وصار `odoo.E001…E004` يسمّي الناقصَ بالاسم.
# ⚠️ وقيمةٌ لا تُفهم (`yes ` بمسافة، `True.` بنقطة، `maybe`) **كانت تُقرأ
# إطفاءً صامتاً**؛ صارت تُرفض عند الإقلاع.
# ---------------------------------------------------------------------------
ODOO_ENABLED=False
ODOO_BASE_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_WEBHOOK_SECRET=
# يُقرأ من البيئة و**لا قارئَ له في الكود** (عقدُ أودو بـBearer لا باسمٍ
# وكلمة). مكتوبٌ هنا لأنه مقروءٌ فعلاً، ولا يُحذف بلا قرار.
ODOO_USERNAME=
# ⚠️ **دفترُ اليوميّة عندهم**، لا رقمٌ داخليّ: غائباً يرث الافتراضيَّ `005/01`
# (قيمةُ v1 للفواتير، و`0002/02` للاشتراكات)، فبيئةُ تجريبٍ تُرحّل مالَ
# الاختبار إلى دفترٍ حقيقيّ بلا أن يُرفض نداءٌ واحد. `odoo.W001` ينبّه حين
# لا يُصرَّح به. **ولا تُغيَّر قيمتُه بلا إذن المالك** (المادة ٥-٤).
# ODOO_PAYMENT_CODE=005/01
# ⚠️ إطفاءُ التحقّق من الشهادة — لأجهزة التطوير وحدها، ويرفضه `odoo.E005`
# في بيئةٍ منشورة.
# ODOO_INSECURE_TLS=False

# ---------------------------------------------------------------------------
# البريد — الإنتاج وحده. 🔇 بلا مضيفٍ يحاول `localhost:587` فيفشل كلُّ إرسال.
# ولا فحصَ عليه اليوم: **صفرُ مُرسِلٍ للبريد في الكود كلِّه** (لا `send_mail`
# ولا `mail_admins`)، فتحذيرٌ عليه تحذيرٌ بلا أثرٍ يُتعلَّم تجاهلُه.
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.example.invalid
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.invalid
# EMAIL_HOST_PASSWORD=REPLACE_ME

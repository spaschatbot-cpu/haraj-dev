# Copy to .env and fill in. .env is never committed.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Shown on /health and in every message leaving a non-production environment.
ENVIRONMENT_NAME=dev
# Set by the build; leave empty locally and /health reads the git ref instead.
GIT_COMMIT=

DATABASE_URL=postgres://haraj:haraj@127.0.0.1:5432/haraj2

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

INSURANCE_DEPOSIT_AMOUNT=10000

# Odoo stays off until someone turns it on deliberately.
ODOO_ENABLED=False
ODOO_BASE_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_WEBHOOK_SECRET=

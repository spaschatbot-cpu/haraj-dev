{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "backend-venv",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8001"
      ],
      "port": 8001,
      "cwd": "backend"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false,
      "cwd": "web"
    },
    {
      "name": "web-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "console-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--directory",
        "backend/.design-preview"
      ],
      "port": 8777
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "mobile/tool/serve_web_with_api.py"
      ],
      "port": 8090
    }
  ]
}
[Unit]
Description=يشغّل فحص الدفتر ومطابقة أودو كل ليلة

[Timer]
# الثالثة فجراً بتوقيت الخادم (UTC): بعد أن تهدأ حركةُ المزادات وقبل أن
# يفتح أحدٌ اللوحةَ صباحاً — فالملاحظةُ تكون على الشاشة قبل أن تُسأل.
OnCalendar=*-*-* 03:00:00
# مشغَّلٌ فات موعدُه (الخادمُ كان مطفأً) يجري عند الإقلاع: فحصٌ فات ليلةً
# يعني ليلةً بلا جواب، وهو ما يُراد تفاديه أصلاً.
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
